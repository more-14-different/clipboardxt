                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="FileJumpTab" Header="文件夹跳转">
                <TabItem.Resources>
                    <sys:String x:Key="FolderJumpHelp_Hotkey_Title">文件对话框跳转键</sys:String>
                    <sys:String x:Key="FolderJumpHelp_Hotkey_Body">点击右侧区域后，按下要绑定的组合键。须与「剪贴板」页中的呼出快捷键、批量模式切换键各不相同。</sys:String>
                    <sys:String x:Key="FolderJumpHelp_Delay_Title">跳转列表延时 (ms)</sys:String>
                    <sys:String x:Key="FolderJumpHelp_Delay_Body">0 表示立即弹出；延时内再按一次跳转键会直接跳到预选路径。</sys:String>
                    <sys:String x:Key="FolderJumpHelp_Follow_Title">跳转列表跟随</sys:String>
                    <sys:String x:Key="FolderJumpHelp_Follow_Body">仅在「对话框打开时自动弹出列表」关闭时可见并生效；该项开启时列表始终贴对话框。跟随对话框：按 Ctrl+G 弹出的列表紧贴文件对话框并随窗口移动。跟随鼠标：按 Ctrl+G 弹出的列表在鼠标附近弹出。</sys:String>
                    <sys:String x:Key="FolderJumpHelp_OpenListOnDialogOpen_Title">对话框打开时自动弹出列表</sys:String>
                    <sys:String x:Key="FolderJumpHelp_OpenListOnDialogOpen_Body">检测到打开/保存对话框成为前台时，自动采集候选并弹出跳转列表（紧贴对话框），让你直接选目标，无需快捷键。同一对话框只自动弹一次；手动 Ctrl+G 不受影响。开启时跳转列表（含 Ctrl+G 弹出）始终贴对话框，「跳转列表跟随」选项隐藏。</sys:String>
                    <sys:String x:Key="FolderJumpHelp_AutoNavigateBest_Title">自动跳转到最佳路径</sys:String>
                    <sys:String x:Key="FolderJumpHelp_AutoNavigateBest_Body">对话框成为前台时直接跳到候选首条（与 Ctrl+G 列表第一条一致），不需要任何点击。同一对话框只自动跳一次。部分宿主（如微信）不发前台切换事件，会在框内首次左键时兜底触发同样动作。与「对话框打开时自动弹出列表」同时开启：先直跳最佳路径再弹列表，你仍能在列表里改换目标。默认关闭，避免未确认即改路径。</sys:String>
                    <sys:String x:Key="FolderJumpHelp_AutoSync_Title">切回时自动同步路径</sys:String>
                    <sys:String x:Key="FolderJumpHelp_AutoSync_Body">从资源管理器/TC 等切回已打开的文件对话框时，会重新采集并刷新候选列表；开启时，若最近一次外部文件夹与对话框当前目录不同，则自动跳转过去（仅当前一次前台在「能采到路径的文件管理器」上时才按外部目录同步，避免在对话框里改路径后到其它程序再切回被误拉回资源管理器旧路径）。与「对话框打开时自动弹出列表」配合：后者偏首次到前台，本项偏每次切回。</sys:String>
                    <sys:String x:Key="FolderJumpHelp_Shell_Title">Shell 注入跳转</sys:String>
                    <sys:String x:Key="FolderJumpHelp_Shell_Body">开启时优先注入宿主进程用 IShellBrowser 切换目录（仅系统公共对话框）。关闭则仅用地址栏/键入模拟，可减少杀软误报或宿主拦截导致的问题。</sys:String>
                    <Style x:Key="FolderJumpHelpGlyphLabel" TargetType="Label">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="6,0,0,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="MinWidth" Value="18" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentBg}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
                        <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
                    </Style>
                    <ToolTip x:Key="FolderJumpTipHotkey" x:Shared="False" MaxWidth="420" Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ThemeBorder}"
                             BorderThickness="1">
                        <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"
                                   Text="{StaticResource FolderJumpHelp_Hotkey_Body}" />
                    </ToolTip>
                    <ToolTip x:Key="FolderJumpTipFollow" x:Shared="False" MaxWidth="420" Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ThemeBorder}"
                             BorderThickness="1">
                        <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"
                                   Text="{StaticResource FolderJumpHelp_Follow_Body}" />
                    </ToolTip>
                    <ToolTip x:Key="FolderJumpTipOpenListOnDialogOpen" x:Shared="False" MaxWidth="420" Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ThemeBorder}"
                             BorderThickness="1">
                        <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"
                                   Text="{StaticResource FolderJumpHelp_OpenListOnDialogOpen_Body}" />
                    </ToolTip>
                    <ToolTip x:Key="FolderJumpTipAutoNavigateBest" x:Shared="False" MaxWidth="420" Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ThemeBorder}"
                             BorderThickness="1">
                        <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"
                                   Text="{StaticResource FolderJumpHelp_AutoNavigateBest_Body}" />
                    </ToolTip>
                    <ToolTip x:Key="FolderJumpTipShell" x:Shared="False" MaxWidth="420" Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ThemeBorder}"
                             BorderThickness="1">
                        <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"
                                   Text="{StaticResource FolderJumpHelp_Shell_Body}" />
                    </ToolTip>
                    <ToolTip x:Key="FolderJumpTipAutoSync" x:Shared="False" MaxWidth="420" Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ThemeBorder}"
                             BorderThickness="1">
                        <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"
                                   Text="{StaticResource FolderJumpHelp_AutoSync_Body}" />
                    </ToolTip>
                    <ToolTip x:Key="FolderJumpTipDelay" x:Shared="False" MaxWidth="420" Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ThemeBorder}"
                             BorderThickness="1">
                        <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"
                                   Text="{StaticResource FolderJumpHelp_Delay_Body}" />
                    </ToolTip>
                    <sys:String x:Key="FolderJumpHelp_EverythingFolder_Body">在跳转列表内输入检索时，除收藏与候选路径外，再用 voidtools Everything 补充匹配的文件夹并追加显示（来源标签为 everything）。本地收藏/候选支持中文拼音检索；Everything 补充结果只按原文件夹名/路径检索，不支持拼音展开。需本机已安装并运行 Everything；单次最大条数与「实验性功能」页中 everything 筛选条数相同。</sys:String>
                    <ToolTip x:Key="FolderJumpTipEverythingFolder" x:Shared="False" MaxWidth="420" Padding="10,8"
                             Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ThemeBorder}"
                             BorderThickness="1">
                        <TextBlock FontSize="13" Foreground="{DynamicResource PrimaryText}" TextWrapping="Wrap"
                                   Text="{StaticResource FolderJumpHelp_EverythingFolder_Body}" />
                    </ToolTip>
                </TabItem.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,0"
                              ToolTipService.InitialShowDelay="0"
                              ToolTipService.BetweenShowDelay="0"
                              ToolTipService.ShowDuration="60000">
                    <Grid Margin="16,10,16,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
