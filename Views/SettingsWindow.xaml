                    <StackPanel Margin="16,10,16,12">
                        <TextBlock Text="右键菜单中的每个条目动作都会显示这里设置的快捷键。点击右侧后直接按下新组合键。"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <StackPanel x:Name="ClipboardItemHotkeysSection">
                            <TextBlock Text="剪贴板条目" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>
                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <TextBlock Text="粘贴" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Grid.Column="1" Tag="ClipboardPaste" Style="{StaticResource ItemActionHotkeyBoxStyle}"><TextBlock x:Name="ClipboardPasteHotkeyText" Style="{StaticResource ItemActionHotkeyTextStyle}"/></Border>
                            </Grid>
                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <TextBlock Text="图片/文本/文件作为文件粘贴" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Grid.Column="1" Tag="ClipboardPasteAsFile" Style="{StaticResource ItemActionHotkeyBoxStyle}"><TextBlock x:Name="ClipboardPasteAsFileHotkeyText" Style="{StaticResource ItemActionHotkeyTextStyle}"/></Border>
                            </Grid>
                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
