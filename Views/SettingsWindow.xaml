                                <Border Grid.Column="1" Tag="ClipboardPasteJson" Style="{StaticResource ItemActionHotkeyBoxStyle}"><TextBlock x:Name="ClipboardPasteJsonHotkeyText" Style="{StaticResource ItemActionHotkeyTextStyle}"/></Border>
                            </Grid>
                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <TextBlock Text="编辑文本" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Grid.Column="1" Tag="ClipboardEditText" Style="{StaticResource ItemActionHotkeyBoxStyle}"><TextBlock x:Name="ClipboardEditTextHotkeyText" Style="{StaticResource ItemActionHotkeyTextStyle}"/></Border>
                            </Grid>
                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <TextBlock Text="设为/修改快捷短语" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Grid.Column="1" Tag="ClipboardShortcutPhrase" Style="{StaticResource ItemActionHotkeyBoxStyle}"><TextBlock x:Name="ClipboardShortcutPhraseHotkeyText" Style="{StaticResource ItemActionHotkeyTextStyle}"/></Border>
                            </Grid>
                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <TextBlock Text="删除" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Grid.Column="1" Tag="ClipboardDelete" Style="{StaticResource ItemActionHotkeyBoxStyle}"><TextBlock x:Name="ClipboardDeleteHotkeyText" Style="{StaticResource ItemActionHotkeyTextStyle}"/></Border>
                            </Grid>
                            <TextBlock Text="收藏/取消收藏仍在“剪贴板”页的“收藏快捷键”中设置。"
                                       Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="FileJumpItemHotkeysSection" Margin="0,20,0,0">
                            <TextBlock Text="文件跳转条目" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,8"/>
                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <TextBlock Text="加入/移除收藏" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Grid.Column="1" Tag="FileJumpFavorite" Style="{StaticResource ItemActionHotkeyBoxStyle}"><TextBlock x:Name="FileJumpFavoriteHotkeyText" Style="{StaticResource ItemActionHotkeyTextStyle}"/></Border>
                            </Grid>
                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <TextBlock Text="修改关键词" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Grid.Column="1" Tag="FileJumpEditPhrase" Style="{StaticResource ItemActionHotkeyBoxStyle}"><TextBlock x:Name="FileJumpEditPhraseHotkeyText" Style="{StaticResource ItemActionHotkeyTextStyle}"/></Border>
                            </Grid>
                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                <TextBlock Text="移除常用路径" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryText}"/>
                                <Border Grid.Column="1" Tag="FileJumpRemoveRecent" Style="{StaticResource ItemActionHotkeyBoxStyle}"><TextBlock x:Name="FileJumpRemoveRecentHotkeyText" Style="{StaticResource ItemActionHotkeyTextStyle}"/></Border>
