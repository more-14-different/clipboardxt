<Window x:Class="ClipboardManager.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardManager"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Width="420"
        SizeToContent="Height"
        MaxHeight="560"
        ResizeMode="CanResize"
        MinWidth="280"
        MinHeight="200">

    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <!-- 批量模式色（与托盘同源）；运行时在 UpdateBatchHeaderUi 中按模式覆盖 -->
            <SolidColorBrush x:Key="BatchModeTagFill" Color="#139493"/>
            <SolidColorBrush x:Key="BatchModeTagFg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BatchModeBadgeFill" Color="#139493"/>
            <SolidColorBrush x:Key="BatchModeBadgeFg" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="KeyboardPointFocusBrush" Color="#139493"/>
            <DrawingBrush x:Key="ThumbnailCheckerBrush"
                          TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#16FFFFFF" Geometry="M0,0 H8 V8 H0 Z"/>
                        <GeometryDrawing Brush="#18000000"
                                         Geometry="M0,0 H4 V4 H0 Z M4,4 H8 V8 H4 Z"/>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedPopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
    <Border x:Name="MainBorder" Background="{DynamicResource PopupBgBrush}" CornerRadius="12" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="16,14,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Cursor="SizeAll"
                            MouseLeftButtonDown="Header_DragStart">
                    <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="剪切板历史" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ItemCountText" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                               VerticalAlignment="Center" Margin="8,1,0,0"/>
                </StackPanel>
                <Border x:Name="BatchModeHeaderBorder" Grid.Column="1" Cursor="Hand"
                        Margin="0,0,8,0" Padding="10,4" CornerRadius="10"
                        Background="{DynamicResource BatchModeTagFill}"
                        MouseLeftButtonUp="BatchModeHeader_Click"
                        MouseRightButtonUp="BatchModeHeader_RightClick"
                        ToolTip="批量：左键循环 普通→LIFO→FIFO（与设置里「批量模式切换键」相同）；右键菜单可一次粘贴队列。Shift+↑↓ 扩展多选。普通：多选 Enter 顺序连贴；FIFO/LIFO：多选 Enter 入队（角标、置顶），新复制自动入队，在他处每次 Ctrl+V 或 Shift+Insert 出队一条">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.92"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="BatchModeHeaderText" Text="普通" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource BatchModeTagFg}" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="PinHeaderBorder" Grid.Column="2" Background="Transparent" CornerRadius="8"
                        Cursor="Hand" Margin="0,0,6,0" Padding="4,2"
                        MouseLeftButtonUp="Pin_Click" ToolTip="置顶：粘贴后保持窗口打开，便于连续粘贴">
                    <TextBlock x:Name="PinHeaderIcon" Text="📌" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryText}"/>
                </Border>
                <Border Grid.Column="3" Background="Transparent" Cursor="Hand" Margin="0,0,10,0"
                        MouseLeftButtonUp="Settings_Click" ToolTip="设置">
                    <TextBlock Text="⚙" FontSize="14" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                </Border>
                <!-- Type filter button -->
                <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                        Padding="8,3" Cursor="Hand" MouseLeftButtonUp="TypeFilter_Click"
                        ToolTip="类型筛选（Tab 切换）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TypeFilterIcon" Text="●" FontFamily="Segoe UI Symbol"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBg}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TypeFilterText" Text="全部" FontSize="11" Margin="5,0,0,0"
                                   Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource ThemeSeparator}"/>

            <!-- Search Bar -->
            <Border x:Name="SearchBarPanel" Grid.Row="1" Visibility="Collapsed"
                    Margin="8,8,8,4" Padding="10,8" Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SearchTextBlock" Grid.Column="1" Foreground="{DynamicResource PrimaryText}"
                               FontSize="13" VerticalAlignment="Center" Background="Transparent" Cursor="IBeam"
                               Focusable="False"
                               PreviewMouseLeftButtonDown="SearchTextBlock_PreviewMouseLeftButtonDown"
                               PreviewMouseLeftButtonUp="SearchTextBlock_PreviewMouseLeftButtonUp"
                               PreviewMouseMove="SearchTextBlock_PreviewMouseMove"
                               LostMouseCapture="SearchTextBlock_LostMouseCapture"/>
                    <TextBlock x:Name="SearchCountText" Grid.Column="2" Foreground="{DynamicResource SecondaryText}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Primary actions stay visible above the list. Full help remains in the footer. -->
            <Border Grid.Row="2" Margin="10,7,10,0" Padding="10,7,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,12,5" VerticalAlignment="Top">
                        <TextBlock Text="核心操作" Padding="7,4" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HintActionBrush}"/>
                    </Grid>
                    <ItemsControl x:Name="PrimaryHints" Grid.Column="1"
                                  ItemTemplate="{StaticResource PanelHintCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Items List -->
            <Grid Grid.Row="3">
                <ListBox x:Name="ItemsList"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="420"
                         Padding="4"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.ScrollChanged="ItemsList_ScrollChanged"
                         PreviewMouseLeftButtonUp="ItemsList_PreviewMouseUp"
                         PreviewMouseRightButtonUp="ItemsList_PreviewMouseRightUp"
                         PreviewMouseDown="ItemsList_PreviewMouseDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0" UseLayoutRounding="True">
                                <Border CornerRadius="8" Padding="0" Margin="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardPointFocus}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource KeyboardPointFocusBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="3" HorizontalAlignment="Left" Margin="0,6,0,6"
                                        CornerRadius="2" Background="{DynamicResource KeyboardPointFocusBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardPointFocus}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <TextBlock Grid.Column="0" Text="{Binding IndexLabel}"
                                           FontSize="10" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedText}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPendingDelete}" Value="True">
                                                    <Setter Property="TextDecorations" Value="{x:Static TextDecorations.Strikethrough}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid Grid.Column="1" Width="30" Height="30" Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IconVisibility}">
                                    <Border CornerRadius="6" Background="#22000000"/>
                                    <Image Source="{Binding DisplayIcon}" Width="22" Height="22"
                                           Stretch="Uniform"
                                           Visibility="{Binding DisplayIconVisibility}"/>
                                    <TextBlock Text="{Binding ContentTypeBadge}"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding TypeFallbackIconVisibility}"/>
                                    <Border Width="16" Height="12" CornerRadius="3"
                                            Background="{DynamicResource PopupBgBrush}"
                                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Visibility="{Binding ContentTypeBadgeVisibility}">
                                        <TextBlock Text="{Binding ContentTypeBadge}"
                                                   FontSize="6.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Column="2" Width="48" Height="36" Padding="1"
                                        CornerRadius="4" Margin="0,0,4,0"
                                        Background="{StaticResource ThumbnailCheckerBrush}"
                                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                        Visibility="{Binding ThumbnailVisibility}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPendingDelete}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                </Border>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0,8,0">
                                    <local:SearchHighlightTextBlock DisplayText="{Binding Preview}"
                                                                   HighlightQuery="{Binding HighlightSearchQuery, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontSizeOverride="13"
                                                                   UseMutedBase="False"
                                                                   IsStrikeThrough="{Binding IsPendingDelete}"/>
                                    <local:SearchHighlightTextBlock DisplayText="{Binding SubInfo, TargetNullValue=''}"
                                                                   HighlightQuery="{Binding HighlightSearchQuery, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontSizeOverride="10"
                                                                   UseMutedBase="True"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding SubInfoVisibility}"
                                                                   IsStrikeThrough="{Binding IsPendingDelete}"/>
                                    <ItemsControl ItemsSource="{Binding SearchMetadataPreviewChips}"
                                                  Margin="0,4,0,0"
                                                  MaxWidth="360"
                                                  Visibility="{Binding SearchMetadataPreviewVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,4,3"
                                                        Padding="5,1"
                                                        CornerRadius="5"
                                                        Background="#273B35"
                                                        BorderBrush="#426258"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1E2D29"/>
                                                            <Setter Property="BorderBrush" Value="#30443F"/>
                                                            <Setter Property="Opacity" Value="0.82"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                    <Setter Property="Background" Value="#273B35"/>
                                                                    <Setter Property="BorderBrush" Value="#426258"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWebUrl}" Value="True">
                                                                    <Setter Property="Background" Value="#3B211D"/>
                                                                    <Setter Property="BorderBrush" Value="#E07A5F"/>
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <local:SearchHighlightTextBlock DisplayText="{Binding Text}"
                                                                                   HighlightQuery="{Binding HighlightSearchQuery, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                   FontSizeOverride="9"
                                                                                   UseMutedBase="True"
                                                                                   IsStrikeThrough="{Binding DataContext.IsPendingDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                        <local:SearchHighlightTextBlock.Style>
                                                            <Style TargetType="local:SearchHighlightTextBlock">
                                                                <Setter Property="NormalForegroundOverride" Value="#8FA39B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                                        <Setter Property="NormalForegroundOverride" Value="#C7D8D0"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsWebUrl}" Value="True">
                                                                        <Setter Property="NormalForegroundOverride" Value="#FFE2D8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </local:SearchHighlightTextBlock.Style>
                                                    </local:SearchHighlightTextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock Grid.Column="4" Text="★"
                                           Foreground="{DynamicResource AccentBg}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Visibility="{Binding StarVisibility}"/>

                                <TextBlock Grid.Column="5" Text="{Binding TimeAgo}"
                                           Foreground="{DynamicResource SecondaryText}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,8,0" TextAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPendingDelete}" Value="True">
                                                    <Setter Property="TextDecorations" Value="{x:Static TextDecorations.Strikethrough}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 队列序号：独立列、Ellipse 保证正圆，不与时间重叠 -->
                                <Grid Grid.Column="6" Width="22" Height="22" Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding HasBatchOrder, Converter={StaticResource BoolVis}}"
                                      SnapsToDevicePixels="True" UseLayoutRounding="True">
                                    <Ellipse Fill="{DynamicResource BatchModeBadgeFill}"/>
                                    <TextBlock Text="{Binding BatchOrderLabel}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BatchModeBadgeFg}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Padding="0,0,0,0"/>
                                </Grid>
                            </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="0,30" Visibility="Visible">
                    <TextBlock x:Name="EmptyIcon" Text="📭" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyText" Text="暂无剪切板记录" Foreground="{DynamicResource SecondaryText}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="EmptySubText" Text="复制一些文本即可开始" Foreground="{DynamicResource MutedText}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="4" Padding="14,8" Background="{DynamicResource FooterBrush}" CornerRadius="0,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,10,5" VerticalAlignment="Top">
                        <TextBlock Text="辅助操作" Padding="7,4" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HintManageBrush}"/>
                    </Grid>
                    <ItemsControl Grid.Column="1" x:Name="FooterHints" VerticalAlignment="Center"
                                  ItemTemplate="{StaticResource PanelHintCardTemplate}"
                                  Margin="0,0,6,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border x:Name="ShortcutHelpMoreBorder" Grid.Column="2" Padding="9,4" CornerRadius="10" Cursor="Hand"
                            VerticalAlignment="Center" MouseLeftButtonUp="ShortcutHelpMore_Click"
                            Background="{DynamicResource HintManageButtonBrush}"
                            ToolTip="展开完整快捷键说明">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.92"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="more" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentFg}" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Popup x:Name="ShortcutHelpPopup" PlacementTarget="{Binding ElementName=ShortcutHelpMoreBorder}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   HorizontalOffset="-120" VerticalOffset="-4">
                <Border Background="{DynamicResource PopupBgBrush}" CornerRadius="10"
                        Padding="12,14" Margin="8" BorderThickness="1"
                        BorderBrush="{DynamicResource ThemeBorder}"
                        MinWidth="430" MaxWidth="500" MaxHeight="540">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="500">
                        <StackPanel>
                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,10,0">
                                    <Grid>
                                        <Border Background="{DynamicResource HintActionBrush}" Opacity="0.16" CornerRadius="9"/>
                                        <TextBlock Text="⌨" FontSize="16" Foreground="{DynamicResource HintActionBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="剪贴板面板 · 快捷键指南" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryText}"/>
                                    <TextBlock x:Name="ShortcutHelpSubtitle" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource HintActionBrush}" Opacity="0.38"
                                    Margin="0,0,0,12"/>
                            <ItemsControl x:Name="ShortcutHelpSections"
                                          ItemTemplate="{StaticResource PanelHintSectionTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- 空格键：条目大图 / 全文预览气泡（再按空格或 Esc 关闭） -->
            <Popup x:Name="EntryPreviewPopup" StaysOpen="True" AllowsTransparency="True"
                   PopupAnimation="Fade" Placement="Right">
                <Border Background="{DynamicResource PopupBgBrush}" CornerRadius="10"
                        Padding="12" Margin="12" BorderThickness="1"
                        BorderBrush="{DynamicResource ThemeBorder}"
                        MaxWidth="540" MaxHeight="440">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                    </Border.Effect>
                    <ScrollViewer x:Name="EntryPreviewScroll" MaxHeight="400"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid x:Name="EntryPreviewShortcutPhraseRow" Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="快捷短语" Style="{StaticResource InfoFieldLabelStyle}"
                                           Margin="0,1,10,0"/>
                                <ContentControl x:Name="EntryPreviewShortcutPhraseChip" Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                ContentTemplate="{StaticResource SearchMetadataChipTemplate}"/>
                            </Grid>
                            <Grid x:Name="EntryPreviewSourcePanel" Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" Background="#22000000" Margin="0,0,8,0">
                                    <Image x:Name="EntryPreviewSourceIcon" Width="24" Height="24" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" UseLayoutRounding="True">
                                    <TextBlock x:Name="EntryPreviewSourceApp" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PreviewAppText}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="标题" Style="{StaticResource InfoFieldLabelStyle}"/>
                                        <TextBlock x:Name="EntryPreviewSourceTitle" Grid.Column="1" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Grid x:Name="EntryPreviewSourcePathRow" Margin="0,2,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="路径" Style="{StaticResource InfoFieldLabelStyle}"/>
                                        <TextBlock x:Name="EntryPreviewSourcePath" Grid.Column="1" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <!-- 两列各自按与 标题→路径 相同的 StackPanel + 顶部 Margin 方式排列，
                                         避免共享行高及 DPI 舍入造成一像素的行距差异。 -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="进程" Style="{StaticResource InfoFieldLabelStyle}"/>
                                                <TextBlock x:Name="EntryPreviewSourceExe" Grid.Column="1" FontSize="10"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="焦点" Style="{StaticResource InfoFieldLabelStyle}"/>
                                                <TextBlock x:Name="EntryPreviewSourceFocus" Grid.Column="1" FontSize="10"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="窗口" Style="{StaticResource InfoFieldLabelStyle}"/>
                                                <TextBlock x:Name="EntryPreviewSourceClass" Grid.Column="1" FontSize="10"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="方式" Style="{StaticResource InfoFieldLabelStyle}"/>
                                                <TextBlock x:Name="EntryPreviewSourceMethod" Grid.Column="1" FontSize="10"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="EntryPreviewImageMeta" FontSize="11"
                                       Foreground="{DynamicResource MutedText}"
                                       Margin="0,0,0,6" Visibility="Collapsed"/>
                            <Grid>
                                <Image x:Name="EntryPreviewImage" Stretch="Uniform"
                                       MaxWidth="500" MaxHeight="380" Visibility="Collapsed"/>
                                <Border x:Name="EntryPreviewImageNav" Visibility="Collapsed"
                                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="6" Padding="6,3" Margin="0,0,0,2"
                                        BorderThickness="1" BorderBrush="{DynamicResource ThemeBorder}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Cursor="Hand" Padding="6,2" MouseLeftButtonUp="EntryPreviewImgPrev_Click">
                                            <TextBlock Text="‹" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                        </Border>
                                        <TextBlock x:Name="EntryPreviewImgIndex" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryText}" Margin="8,0"/>
                                        <Border Cursor="Hand" Padding="6,2" MouseLeftButtonUp="EntryPreviewImgNext_Click">
                                            <TextBlock Text="›" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryText}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border x:Name="EntryPreviewOcrSeparator" Height="1"
                                    Background="{DynamicResource ThemeSeparator}"
                                    Margin="0,10,0,8" Visibility="Collapsed"/>
                            <TextBlock x:Name="EntryPreviewOcrHeader" Text="识别文字"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,0,0,6" Visibility="Collapsed"/>
                            <TextBlock x:Name="EntryPreviewOcrText" FontSize="12"
                                       Foreground="{DynamicResource PrimaryText}"
                                       TextWrapping="Wrap" LineHeight="18"
                                       MaxWidth="500" Visibility="Collapsed"/>
                            <TextBlock x:Name="EntryPreviewText" FontSize="13"
                                       Foreground="{DynamicResource PrimaryText}"
                                       TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>

            <!-- Context Menu Popup -->
            <Popup x:Name="ContextPopup" StaysOpen="False" Placement="Mouse"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                        Padding="4" Margin="8" BorderThickness="1"
                        BorderBrush="{DynamicResource ThemeBorder}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border x:Name="CtxPasteBorder" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                MouseLeftButtonUp="CtxPaste_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinWidth="300">
                                <TextBlock Text="📋 粘贴" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock x:Name="CtxPasteHotkeyText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border x:Name="CtxLinePasteBorder" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="CtxLinePaste_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinWidth="300">
                                <TextBlock Text="↵ 逐项换行粘贴" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock Text="Alt+Enter" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border x:Name="CtxSoftLinePasteBorder" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="CtxSoftLinePaste_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinWidth="300">
                                <TextBlock Text="↲ 逐项软换行粘贴" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock Text="Shift+Enter" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border x:Name="CtxOpenUrlsBorder" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="CtxOpenUrls_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinWidth="300">
                                <TextBlock Text="🌐 打开所选网址" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock Text="Alt+Shift+Enter" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border x:Name="CtxPasteAsFileBorder" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="CtxPasteAsFile_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinWidth="300">
                                <TextBlock Text="📁 作为文件粘贴（资源管理器）" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock x:Name="CtxPasteAsFileHotkeyText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border x:Name="CtxPasteJsonFileBorder" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="CtxPasteJsonFile_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinWidth="300">
                                <TextBlock Text="📄 粘贴为 JSON 文件（资源管理器）" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock x:Name="CtxPasteJsonHotkeyText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border x:Name="CtxEditTextBorder" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                Visibility="Collapsed"
                                MouseLeftButtonUp="CtxEditText_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinWidth="300">
                                <TextBlock Text="✏️ 编辑文本" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock x:Name="CtxEditTextHotkeyText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border x:Name="CtxShortcutBorder" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                MouseLeftButtonUp="CtxShortcut_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinWidth="300">
                                <TextBlock x:Name="CtxShortcutText" Text="⚡ 设为快捷短语" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock x:Name="CtxShortcutHotkeyText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border x:Name="CtxStarBorder" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                MouseLeftButtonUp="CtxStar_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinWidth="300">
                                <TextBlock x:Name="CtxStarText" Text="★ 收藏" Foreground="{DynamicResource PrimaryText}" FontSize="13"/>
                                <TextBlock x:Name="CtxStarHotkeyText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </Grid>
                        </Border>
                        <Border Height="1" Background="{DynamicResource ThemeSeparator}" Margin="4,2"/>
                        <Border x:Name="CtxDeleteBorder" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                MouseLeftButtonUp="CtxDelete_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid MinWidth="300">
                                <TextBlock Text="🗑 删除" Foreground="{DynamicResource SecondaryText}" FontSize="13"/>
                                <TextBlock x:Name="CtxDeleteHotkeyText" HorizontalAlignment="Right" Foreground="{DynamicResource MutedText}" FontSize="12"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="BatchMenuPopup" StaysOpen="False"
                   PlacementTarget="{Binding ElementName=BatchModeHeaderBorder}"
                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="4" Margin="8"
                        BorderThickness="1" BorderBrush="{DynamicResource ThemeBorder}" MinWidth="220">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border x:Name="BatchRowPasteAll" Padding="10,7" CornerRadius="6" Cursor="Hand"
                                MouseLeftButtonUp="BatchMenu_PasteAll_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="📋 批量粘贴（依次贴完全部队列）" Foreground="{DynamicResource PrimaryText}" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>

    <!-- Phrase Edit Side Panel -->
    <Popup x:Name="PhraseEditPopup" StaysOpen="True" Placement="Right"
           PlacementTarget="{Binding ElementName=MainBorder}"
           AllowsTransparency="True" HorizontalOffset="-12" VerticalOffset="0">
        <Border Background="{DynamicResource PopupBgBrush}" CornerRadius="12"
                Padding="16" Margin="8,16,16,16" Width="240">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="⚡ 快捷短语" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                <TextBlock x:Name="PhrasePreview" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,12" MaxHeight="36"
                           TextWrapping="Wrap"/>
                <TextBlock Text="短语关键词" FontSize="12"
                           Foreground="{DynamicResource MutedText}" Margin="0,0,0,6"/>
                <Border MinHeight="34" Padding="8,6" CornerRadius="6"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
                    <TextBlock x:Name="PhraseEditDisplay" FontSize="13" TextWrapping="Wrap"
                               VerticalAlignment="Center" Background="Transparent" Cursor="IBeam"
                               Focusable="False"
                               PreviewMouseLeftButtonDown="PhraseEditDisplay_PreviewMouseLeftButtonDown"
                               PreviewMouseLeftButtonUp="PhraseEditDisplay_PreviewMouseLeftButtonUp"
                               PreviewMouseMove="PhraseEditDisplay_PreviewMouseMove"
                               LostMouseCapture="PhraseEditDisplay_LostMouseCapture"/>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Border Padding="10,6" CornerRadius="6" Cursor="Hand" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBrush}"
                            MouseLeftButtonUp="PhraseCancel_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="取消" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                    </Border>
                    <Border Padding="10,6" CornerRadius="6" Cursor="Hand"
                            MouseLeftButtonUp="PhraseConfirm_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="确定" FontSize="12" Foreground="{DynamicResource AccentFg}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>

    <!-- 文本条目：右键「编辑文本」就地修改内容并写回历史 -->
    <Popup x:Name="TextEntryEditPopup" StaysOpen="True" Placement="Custom"
           PlacementTarget="{Binding ElementName=MainBorder}"
           AllowsTransparency="True"
           Opened="TextEntryEditPopup_Opened">
        <Border Background="{DynamicResource PopupBgBrush}" CornerRadius="12"
                Padding="16" Margin="8,16,16,16" MinWidth="320" MaxWidth="520">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="✏️ 编辑文本" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}" Margin="0,0,0,10"/>
                <TextBlock Text="保存后将替换当前历史项（含数据库中的记录）。" FontSize="11"
                           Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBox x:Name="EntryTextEditBox" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="180" MaxHeight="360"
                         FontSize="13" Padding="8,6"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource PrimaryText}"
                         BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                         PreviewKeyDown="EntryTextEditBox_PreviewKeyDown"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Border Padding="10,6" CornerRadius="6" Cursor="Hand" Margin="0,0,8,0"
                            Background="{DynamicResource SurfaceBrush}"
                            MouseLeftButtonUp="EntryTextEditCancel_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="取消" FontSize="12" Foreground="{DynamicResource SecondaryText}"/>
                    </Border>
                    <Border Padding="10,6" CornerRadius="6" Cursor="Hand"
                            MouseLeftButtonUp="EntryTextEditSave_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentBg}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="保存" FontSize="12" Foreground="{DynamicResource AccentFg}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>
    <!-- 右下角 resize grip 指示器 -->
    <Canvas Width="14" Height="14"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,14,14" IsHitTestVisible="False" Opacity="0.25">
        <Line X1="3" Y1="11" X2="11" Y2="3" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1"/>
        <Line X1="7" Y1="11" X2="11" Y2="7" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1"/>
    </Canvas>
    </Grid>
</Window>
