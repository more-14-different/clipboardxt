<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ClipboardManager"
                    xmlns:models="clr-namespace:ClipboardManager.Models">
    <!-- 语义色承载器：同类操作跨顶部、底部与 more 保持同色。 -->
    <Style x:Key="PanelHintToneCarrierStyle" TargetType="{x:Type FrameworkElement}">
        <Setter Property="Tag" Value="{DynamicResource HintActionBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:PanelHintTone.Transfer}">
                <Setter Property="Tag" Value="{DynamicResource HintTransferBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:PanelHintTone.Search}">
                <Setter Property="Tag" Value="{DynamicResource HintSearchBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:PanelHintTone.Navigation}">
                <Setter Property="Tag" Value="{DynamicResource HintNavigationBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:PanelHintTone.Filter}">
                <Setter Property="Tag" Value="{DynamicResource HintFilterBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:PanelHintTone.Manage}">
                <Setter Property="Tag" Value="{DynamicResource HintManageBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:PanelHintTone.Exit}">
                <Setter Property="Tag" Value="{DynamicResource HintExitBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 顶部与底部共用：每个「快捷键—功能」pair 都是独立的莫兰迪卡片。 -->
    <DataTemplate x:Key="PanelHintCardTemplate">
        <Grid x:Name="CardToneRoot" Margin="0,0,6,5"
              Style="{StaticResource PanelHintToneCarrierStyle}">
            <Border Background="{Binding Tag, ElementName=CardToneRoot}" Opacity="0.11" CornerRadius="6"/>
            <Border BorderBrush="{Binding Tag, ElementName=CardToneRoot}" BorderThickness="1"
                    Opacity="0.34" CornerRadius="6"/>
            <StackPanel Orientation="Horizontal" Margin="7,4">
                <TextBlock Text="{Binding Key}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{Binding Tag, ElementName=CardToneRoot}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Label}" FontSize="10" Margin="6,0,0,0"
                           Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- more 指南：快捷键与完整说明对齐成易扫读的两列表格。 -->
    <DataTemplate x:Key="PanelHintDetailRowTemplate">
        <Grid x:Name="DetailToneRoot" Margin="0,3,0,3"
              Style="{StaticResource PanelHintToneCarrierStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,10,0" HorizontalAlignment="Left">
                <Border Background="{Binding Tag, ElementName=DetailToneRoot}" Opacity="0.12" CornerRadius="5"/>
                <Border BorderBrush="{Binding Tag, ElementName=DetailToneRoot}" BorderThickness="1"
                        Opacity="0.38" CornerRadius="5"/>
                <TextBlock Text="{Binding Key}" Padding="7,3" FontSize="10.5"
                           FontWeight="SemiBold" Foreground="{Binding Tag, ElementName=DetailToneRoot}"
                           TextWrapping="Wrap"/>
            </Grid>
            <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11.5"
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"
                       LineHeight="17" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <!-- more 指南：按任务分组，标题先于内容，组间由留白和分割线区分。 -->
    <DataTemplate x:Key="PanelHintSectionTemplate">
        <StackPanel x:Name="SectionToneRoot" Margin="0,0,0,13"
                    Style="{StaticResource PanelHintToneCarrierStyle}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,9,0">
                    <Grid>
                        <Border Background="{Binding Tag, ElementName=SectionToneRoot}" Opacity="0.14" CornerRadius="7"/>
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Symbol" FontSize="13"
                                   Foreground="{Binding Tag, ElementName=SectionToneRoot}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding Tag, ElementName=SectionToneRoot}"/>
                    <TextBlock Text="{Binding Description}" FontSize="9.5" Margin="0,1,0,0"
                               Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Border Height="1" Background="{Binding Tag, ElementName=SectionToneRoot}" Opacity="0.28"
                    Margin="37,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource PanelHintDetailRowTemplate}"/>
        </StackPanel>
    </DataTemplate>

    <!-- Ctrl+G 列表与 F1 详情共用：可搜索元数据值。 -->
    <DataTemplate x:Key="SearchMetadataChipTemplate">
        <Border Margin="0,0,4,3"
                Padding="5,1"
                CornerRadius="5"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1E2D29"/>
                    <Setter Property="BorderBrush" Value="#30443F"/>
                    <Setter Property="Opacity" Value="0.82"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                            <Setter Property="Background" Value="#2E2F36"/>
                            <Setter Property="BorderBrush" Value="#51535E"/>
                            <Setter Property="Opacity" Value="0.9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMatch}" Value="True">
                            <Setter Property="Background" Value="#273B35"/>
                            <Setter Property="BorderBrush" Value="#426258"/>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWebUrl}" Value="True">
                            <Setter Property="Background" Value="#3B211D"/>
                            <Setter Property="BorderBrush" Value="#E07A5F"/>
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <local:SearchHighlightTextBlock DisplayText="{Binding Text}"
                                                   FontSizeOverride="9"
                                                   UseMutedBase="True">
                <local:SearchHighlightTextBlock.Style>
                    <Style TargetType="local:SearchHighlightTextBlock">
                        <Setter Property="HighlightQuery" Value="{Binding HighlightSearchQuery, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="NormalForegroundOverride" Value="#8FA39B"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                <Setter Property="HighlightQuery" Value=""/>
                                <Setter Property="NormalForegroundOverride" Value="#B7BBC7"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                <Setter Property="NormalForegroundOverride" Value="#C7D8D0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsWebUrl}" Value="True">
                                <Setter Property="NormalForegroundOverride" Value="#FFE2D8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:SearchHighlightTextBlock.Style>
            </local:SearchHighlightTextBlock>
        </Border>
    </DataTemplate>

    <!-- F1 详情中的字段名：橘灰纯文本，与不可搜索的状态 chip 明确区分。 -->
    <Style x:Key="InfoFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#B69A7A"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- 与 PopupWindow 一致的列表项与滚动条（主题色由 Application.Resources / ThemeManager 提供） -->
    <Style TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="10,5"
                            Margin="4,1"
                            BorderThickness="1"
                            BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBd"
                                                    Background="{DynamicResource SecondaryText}"
                                                    CornerRadius="3"
                                                    Opacity="0.3"
                                                    Margin="1,0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Opacity" Value="0.55"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
