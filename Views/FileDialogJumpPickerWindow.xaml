<Window x:Class="ClipboardManager.FileDialogJumpPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardManager"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Width="500"
        MinWidth="280"
        MinHeight="200"
        SizeToContent="Height"
        MaxHeight="620"
        ShowActivated="True"
        Title="ClipboardX — 跳转到文件夹">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SharedPopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainBorder" Background="{DynamicResource PopupBgBrush}" CornerRadius="12" Margin="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="FileJumpHeaderPanel" Grid.Row="0" Margin="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="跳转到文件夹" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                            Padding="8,3" Margin="8,0,0,0" Cursor="Hand"
                            MouseLeftButtonUp="FileJumpTypeFilter_Click"
                            ToolTip="类型筛选（Tab 切换）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FileJumpTypeFilterIcon" Text="●" FontFamily="Segoe UI Symbol"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBg}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FileJumpTypeFilterText" Text="全部" FontSize="11" Margin="5,0,0,0"
                                       Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource ThemeSeparator}"/>

                <Border x:Name="SearchBarPanel" Grid.Row="2" Visibility="Collapsed"
                        Margin="8,8,8,4" Padding="10,8" Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SearchTextBlock" Grid.Column="1" Foreground="{DynamicResource PrimaryText}"
                                   FontSize="13" VerticalAlignment="Center" Background="Transparent" Cursor="IBeam"
                                   Focusable="False"
                                   PreviewMouseLeftButtonDown="SearchTextBlock_PreviewMouseLeftButtonDown"
                                   PreviewMouseLeftButtonUp="SearchTextBlock_PreviewMouseLeftButtonUp"
                                   PreviewMouseMove="SearchTextBlock_PreviewMouseMove"
                                   LostMouseCapture="SearchTextBlock_LostMouseCapture"/>
                        <TextBlock x:Name="SearchCountText" Grid.Column="2" Foreground="{DynamicResource SecondaryText}"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Margin="10,7,10,0" Padding="10,7,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,12,5" VerticalAlignment="Top">
                            <TextBlock Text="核心操作" Padding="7,4" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HintActionBrush}"/>
                        </Grid>
                        <ItemsControl x:Name="FileJumpPrimaryHints" Grid.Column="1"
                                      ItemTemplate="{StaticResource PanelHintCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>

                <ListBox x:Name="ItemsList" Grid.Row="4" Margin="4,0,4,0"
                         Background="Transparent"
                         BorderThickness="0"
                         FocusVisualStyle="{x:Null}"
                         Padding="4"
                         MaxHeight="440"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.ScrollChanged="ItemsList_ScrollChanged"
                         PreviewMouseLeftButtonUp="ItemsList_OnPreviewMouseLeftButtonUp"
                         PreviewMouseRightButtonUp="ItemsList_PreviewMouseRightButtonUp">
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="JumpRowContextMenu" Opened="JumpRowContextMenu_Opened">
                            <MenuItem x:Name="CtxCommitSelection" Header="打开" InputGestureText="Enter"
                                      Click="CtxCommitSelection_Click"/>
                            <MenuItem x:Name="CtxTransferPath" Header="粘贴路径" InputGestureText="Ctrl+Enter"
                                      Click="CtxTransferPath_Click"/>
                            <Separator/>
                            <MenuItem x:Name="CtxAddFavorite" Header="⭐ 加入收藏" Click="CtxAddFavorite_Click"/>
                            <MenuItem x:Name="CtxRemoveFavorite" Header="移除收藏" Click="CtxRemoveFavorite_Click"/>
                            <MenuItem x:Name="CtxEditPhrase" Header="✎ 修改关键词…" Click="CtxEditPhrase_Click"/>
                            <Separator/>
                            <MenuItem x:Name="CtxRemoveRecentFolder" Header="移除常用路径" Click="CtxRemoveRecentFolder_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:FileJumpPickerRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding IndexLabel}"
                                           FontSize="10" TextAlignment="Center"
                                           Foreground="{DynamicResource MutedText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding TypeIcon}"
                                           FontSize="14" Width="26" TextAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <local:SearchHighlightTextBlock DisplayText="{Binding PathLineTruncated}"
                                                                   ToolTip="{Binding PathLine}"
                                                                   HighlightQuery="{Binding HighlightSearchQuery, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontSizeOverride="13"
                                                                   UseMutedBase="False"/>
                                    <ItemsControl ItemsSource="{Binding DisplayMetadataChips}"
                                                  Margin="0,4,0,0"
                                                  MaxWidth="360"
                                                  Visibility="{Binding MetadataChipsVisibility}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <StaticResource ResourceKey="SearchMetadataChipTemplate"/>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="★"
                                           Foreground="{DynamicResource AccentBg}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                           Visibility="{Binding StarVisibility}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="5" Padding="14,8" Background="{DynamicResource FooterBrush}"
                        CornerRadius="0,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Margin="0,0,10,5" VerticalAlignment="Top">
                            <TextBlock Text="辅助操作" Padding="7,4" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HintManageBrush}"/>
                        </Grid>
                        <ItemsControl x:Name="FooterHintsText" Grid.Column="1" VerticalAlignment="Center"
                                      ItemTemplate="{StaticResource PanelHintCardTemplate}"
                                      Margin="0,0,6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Border x:Name="FileJumpShortcutHelpMoreBorder" Grid.Column="2"
                                Padding="9,4" CornerRadius="10" Cursor="Hand"
                                VerticalAlignment="Center"
                                MouseLeftButtonUp="FileJumpShortcutHelpMore_Click"
                                Background="{DynamicResource HintManageButtonBrush}"
                                ToolTip="展开完整快捷键说明">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.92"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="more" FontSize="10" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Popup x:Name="FileJumpShortcutHelpPopup"
               PlacementTarget="{Binding ElementName=FileJumpShortcutHelpMoreBorder}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-120"
               VerticalOffset="-4">
            <Border Background="{DynamicResource PopupBgBrush}" CornerRadius="10"
                    Padding="12,14" Margin="8" BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    MinWidth="430" MaxWidth="500" MaxHeight="540">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="500">
                    <StackPanel>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,10,0">
                                <Grid>
                                    <Border Background="{DynamicResource HintActionBrush}" Opacity="0.16" CornerRadius="9"/>
                                    <TextBlock Text="⌨" FontSize="16" Foreground="{DynamicResource HintActionBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="文件夹面板 · 快捷键指南" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock x:Name="FileJumpShortcutHelpSubtitle" FontSize="10" Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource HintActionBrush}" Opacity="0.38"
                                Margin="0,0,0,12"/>
                        <ItemsControl x:Name="FileJumpShortcutHelpSections"
                                      ItemTemplate="{StaticResource PanelHintSectionTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
        <Popup x:Name="JumpPreviewPopup"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Placement="Right"
               StaysOpen="True">
            <Border Background="{DynamicResource PopupBgBrush}" CornerRadius="10"
                    Padding="12" Margin="12" BorderThickness="1"
                    BorderBrush="{DynamicResource ThemeBorder}"
                    MaxWidth="560" MaxHeight="360">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                </Border.Effect>
                <ScrollViewer MaxHeight="320"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="标签" Style="{StaticResource InfoFieldLabelStyle}" Margin="0,1,10,9"/>
                        <ItemsControl x:Name="JumpPreviewTags" Grid.Column="1" Margin="0,0,0,6"
                                      ItemTemplate="{StaticResource SearchMetadataChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Grid.Row="1" Text="文件夹" Style="{StaticResource InfoFieldLabelStyle}"
                                   Margin="0,1,10,0"/>
                        <TextBlock x:Name="JumpPreviewPath" Grid.Row="1" Grid.Column="1" FontSize="13"
                                   Foreground="{DynamicResource PrimaryText}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Popup>
    <!-- 右下角 resize grip 指示器 -->
    <Canvas Width="14" Height="14"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,14,14" IsHitTestVisible="False" Opacity="0.25">
        <Line X1="3" Y1="11" X2="11" Y2="3" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1"/>
        <Line X1="7" Y1="11" X2="11" Y2="7" Stroke="{DynamicResource SecondaryText}" StrokeThickness="1"/>
    </Canvas>
    </Grid>
</Window>
